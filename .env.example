TYPESAFE_API_KEY=your_typesafe_key

# Optional overrides
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_AUTO_LUNA_MODEL=gpt-5.6-luna
# JEV_AUTO_TERRA_MODEL=gpt-5.6-terra
# JEV_AUTO_SOL_MODEL=gpt-5.6-sol
# JEV_AUTO_ASTRA_MODEL=gpt-6-astra

# Optional Claude Code model overrides. The default aliases are haiku, sonnet,
# and opus; use a full model ID only when it is available to your Claude Code account.
# JEV_AUTO_CLAUDE_LUNA_MODEL=haiku
# JEV_AUTO_CLAUDE_TERRA_MODEL=sonnet
# JEV_AUTO_CLAUDE_SOL_MODEL=opus
# JEV_AUTO_CLAUDE_ASTRA_MODEL=opus
# JEV_AUTO_CLAUDE_CACHE_LOCK_TOKENS=12000
# JEV_AUTO_CLAUDE_MIN_TURNS_PER_MODEL=3
